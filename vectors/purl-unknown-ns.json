{
  "description": "Spice Labs synthetic vectors for unknown namespaces (NOT vendored from purl-spec). Types that require a namespace can use the sentinel \"~unknown\" when the real one isn't known. Extends the purl test format: parse/build/roundtrip cases may set \"missing_namespace\": \"unknown\" to use the lenient path, \"is_namespace_unknown\" cases take a purl string and expect a boolean, and \"refines\" cases take {known, partial} purl strings and expect a boolean.",
  "tests": [
    {
      "description": "lenient parse gives alpm the unknown namespace",
      "test_type": "parse",
      "missing_namespace": "unknown",
      "input": "pkg:alpm/name",
      "expected_output": {
        "type": "alpm",
        "namespace": "~unknown",
        "name": "name",
        "version": null,
        "qualifiers": null,
        "subpath": null
      },
      "expected_failure": false
    },
    {
      "description": "lenient parse gives apk the unknown namespace",
      "test_type": "parse",
      "missing_namespace": "unknown",
      "input": "pkg:apk/name",
      "expected_output": {
        "type": "apk",
        "namespace": "~unknown",
        "name": "name",
        "version": null,
        "qualifiers": null,
        "subpath": null
      },
      "expected_failure": false
    },
