{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spice-labs-inc/coordinates/vectors/vectors.schema.json",
  "title": "coordinates intrinsic identifier vectors",
  "type": "object",
  "required": ["vectors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input_hex", "expect"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "input_hex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$",
            "description": "Input bytes as lowercase hex; empty string for empty input."
          },
          "expect": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" },
            "propertyNames": {
              "enum": ["md5", "sha1", "sha256", "sha512", "gitoid-blob-sha1", "gitoid-blob-sha256"]
            }
          }
        }
      }
    }
  }
}
